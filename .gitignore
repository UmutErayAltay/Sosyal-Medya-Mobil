# İmzalama anahtarı + şifresi — ASLA commit edilmez (uygulamayı güncellemenin tek yolu bu dosya + şifresi, sızarsa/kaybolursa geri dönüşü yok)
android.keystore
*.jks
*.keystore
KEYSTORE_INFO.txt

# Gradle / Android build çıktıları
.gradle/
build/
local.properties
*.apk
*.aab
# APK dağıtımı repo ağacında DEĞİL, GitHub Releases'te (gh release create) —
# 2026-08-08, bkz. https://github.com/UmutErayAltay/Sosyal-Medya-Mobil/releases

*.idsig
*.log
manifest-checksum.txt

# Delta güncelleme (release.ps1) çıktıları — APK'yla AYNI mantık: repo
# ağacında değil, GitHub Releases'te (patch-*.zst, update-manifest.json,
# native-app/dist/history/*.apk yayın öncesi yerel önbellek).
native-app/dist/
# İkili/jar araçları — SHA-256 ile pinlenip release.ps1 tarafından
# doğrulanıyor, tekrar üretilebilir (indirme kaynakları tools/release.ps1
# yorumlarında), commit edilmeye gerek yok.
native-app/tools/.cache/

# IDE
.idea/
*.iml
.DS_Store

# Mimari & aktif görev dokümanları (sosyal-medya deposundaki .context/ ile
# AYNI model — kod taramadan önce buraya bakılır, ama repoya commit edilmez,
# sadece içeriği serbestçe güncellenir)
.context/

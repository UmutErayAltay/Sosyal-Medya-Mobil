<?xml version="1.0" encoding="utf-8"?>
<!--
    CameraX'in çektiği fotoğraf/videoyu FileProvider ile content:// Uri'sine
    çevirmek için gerekli (StoryCreateScreen.kt — kamera akışı, Instagram tarzı
    hikaye oluşturma). Galeri Uri'leri zaten sistemin kendi content provider'ından
    (MediaStore) geldiği için bu dosya SADECE uygulamanın kendi çektiği/kaydettiği
    geçici dosyalar için gerekiyor. context.cacheDir/story_media/ altına
    kaydediyoruz (StoryCreateScreen.kt createStoryMediaFile()) — bu yüzden
    cache-path, "story_media/" alt dizinini eşliyor.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="story_media" path="story_media/" />
    <!-- 2026-08-13: delta güncelleme planı — cacheDir/updates/ context.filesDir/
         updates/'a TAŞINDI (bkz. UpdateStorage.kt): cacheDir OS tarafından
         baskı altında tahliye edilebiliyor, 58 MB'lık bir indirme/yama
         uygulamanın ORTASINDA bu ölümcül olurdu. Eski cache-path girdisi
         geriye dönük uyumluluk için (önceki sürümde oraya yazılmış artık bir
         dosya varsa FileProvider hâlâ Uri üretebilsin diye) KORUNDU. -->
    <cache-path name="updates" path="updates/" />
    <files-path name="updates" path="updates/" />
    <!-- 2026-08-22: sohbet ekranında kamera butonu (ConversationScreen.kt
         createChatCameraFile()) — sistem kamera uygulamasının fotoğrafı
         yazacağı Uri, story_media ile AYNI gerekçeyle ayrı bir alt dizin. -->
    <cache-path name="chat_media" path="chat_media/" />
</paths>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Faz 5 Dalga 4A: FCM push bildirimi — Android 13+/API 33'te runtime izin
         de gerekir (bkz. MainActivity.onCreate()), ama manifest deklarasyonu
         HER durumda şart. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Instagram tarzı hikaye oluşturma akışı (StoryCreateScreen.kt) — canlı
         kamera önizlemesi + foto/video çekimi için runtime izin de gerekir
         (izin akışı ekranın KENDİSİNDE isteniyor, MainActivity'de DEĞİL —
         bkz. StoryCreateScreen.kt yorumu, bu ekrana özel bir izin her
         uygulama açılışında istenmemeli). RECORD_AUDIO: Instagram'da hikaye
         videosu sesli kaydedilir, bu yüzden video kaydı için de isteniyor —
         mesajlaşmadaki "ses mesajı kapsam dışı" notundan BAĞIMSIZ, farklı bir
         özellik. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- required="false": kamerası olmayan cihazlarda da galeri yoluyla
         hikaye paylaşımı çalışmaya devam etmeli, Play Store bu cihazları
         filtrelemesin. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".SosyalApplication"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.SosyalNative"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SosyalNative"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Faz 5 Dalga 4A: FCM push bildirimi — onNewToken/onMessageReceived
             burada işlenir (bkz. service/FcmService.kt). -->
        <service
            android:name=".service.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- CameraX'in çektiği fotoğraf/videonun content:// Uri'sine çevrilmesi
             için (galeri Uri'leri zaten MediaStore'un kendi provider'ından
             geliyor, bunlar için ayrı bir şey gerekmiyordu — sadece kendi
             çektiğimiz geçici dosyalar için FileProvider şart). Bkz.
             res/xml/file_paths.xml ve StoryCreateScreen.kt. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>

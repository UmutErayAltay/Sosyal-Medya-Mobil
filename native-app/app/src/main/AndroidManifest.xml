<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Faz 5 Dalga 4A: FCM push bildirimi — Android 13+/API 33'te runtime izin
         de gerekir (bkz. MainActivity.onCreate()), ama manifest deklarasyonu
         HER durumda şart. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Instagram tarzı hikaye oluşturma akışı (StoryCreateScreen.kt) — canlı
         kamera önizlemesi + foto/video çekimi için runtime izin de gerekir
         (izin akışı ekranın KENDİSİNDE isteniyor, MainActivity'de DEĞİL —
         bkz. StoryCreateScreen.kt yorumu, bu ekrana özel bir izin her
         uygulama açılışında istenmemeli). RECORD_AUDIO: Instagram'da hikaye
         videosu sesli kaydedilir, bu yüzden video kaydı için de isteniyor —
         mesajlaşmadaki "ses mesajı kapsam dışı" notundan BAĞIMSIZ, farklı bir
         özellik. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 2026-08-09: uygulama içi güncelleme (Ayarlar > Uygulama Güncellemeleri) —
         Play Store DIŞINDA dağıtılan bir APK'yı kendi indirip kurdurabilmek için
         ZORUNLU (Android 8+/API 26'da "special permission", runtime dialog YOK —
         kullanıcı Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES üzerinden AÇIKÇA
         izin vermeli, bkz. UpdateRepository.kt). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- required="false": kamerası olmayan cihazlarda da galeri yoluyla
         hikaye paylaşımı çalışmaya devam etmeli, Play Store bu cihazları
         filtrelemesin. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".SosyalApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.SosyalNative"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.SosyalNative"
            android:label="@string/app_name">
            <!-- launchMode="singleTask" (2026-08-21, App Links'in GEREKTİRDİĞİ):
                 uygulama TEK Activity (tüm ekranlar Compose Navigation ile
                 AYNI MainActivity içinde) — varsayılan "standard" modda
                 uygulama AÇIKKEN bir link tıklanınca Android onNewIntent()
                 ÇAĞIRMAZ, ÜSTÜNE İKİNCİ bir MainActivity örneği yığar (geri
                 tuşu garip davranır, iki ayrı NavHost/state canlı kalır).
                 singleTask VARSA örneği ÖNE getirip onNewIntent() çağırır —
                 bkz. MainActivity.onNewIntent(). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links (2026-08-21) — paylaşılan bir post/profil/hashtag
                 linki artık tarayıcıya DÜŞMEDEN doğrudan uygulamada açılır.
                 android:autoVerify="true" Android'e kurulumda/ilk açılışta
                 /.well-known/assetlinks.json'ı (app/__init__.py assetlinks(),
                 sosyal-medya reposu) sorgulatıp bu paketin (applicationId +
                 imzalayan sertifikanın SHA-256'sı) o domain için GERÇEKTEN
                 yetkili olduğunu doğrular — doğrulama tutmazsa (ör. imzalama
                 anahtarı değişirse, bkz. assetlinks() içindeki AYNI uyarı)
                 Android SESSİZCE eski davranışa (seçim diyaloğu/tarayıcı)
                 düşer, kırılma GÖRÜNMEZ. Tek `<intent-filter>` içindeki BİRDEN
                 FAZLA `<data>` etiketi Android'de birleşir (host+scheme TEK
                 elemanda, path'ler AYRI elemanlarda) — bu STANDART desen,
                 üçünü ayrı intent-filter'lara BÖLMEK gerekmez. İşlenmeyen
                 (kapsam dışı) bir path'e (ör. /admin/*) gelen link BİLEREK
                 dahil edilmedi — sadece native'in KARŞILIĞI olan üç yol
                 (post/profil/hashtag, bkz. AppNavHost.kt handleDeepLink()). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="sosyalmedyadeneme.onrender.com" />
                <data android:pathPrefix="/post/" />
                <data android:pathPrefix="/u/" />
                <data android:pathPrefix="/hashtag/" />
            </intent-filter>

            <!-- Share-target (2026-08-21) — Android'in paylaş menüsünden
                 ("Diğer uygulamalarla paylaş") bir metin/link veya TEK görsel
                 doğrudan bu uygulamanın yeni-gönderi ekranına gelebilsin diye.
                 İki AYRI intent-filter GEREKİR (bkz. MainActivity.consumeShareIntent()
                 — text/plain EXTRA_TEXT okur, image/* EXTRA_STREAM okur, TEK
                 bir filtrede iki mimeType'ı birleştirmek Android'de belirsiz
                 eşleşmeye yol açar). SEND_MULTIPLE (çoklu görsel paylaşımı)
                 BİLİNÇLİ olarak kapsam dışı — CreatePostScreen zaten TEK
                 seçimle test edilen bir akışa `onImagesSelected(listOf(uri))`
                 ile bağlanıyor, çoklu paylaşılan görsel gelirse SADECE
                 ilki kullanılır (ayrı bir SEND_MULTIPLE dalı İCAT EDİLMEDİ). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Faz 5 Dalga 4A: FCM push bildirimi — onNewToken/onMessageReceived
             burada işlenir (bkz. service/FcmService.kt). -->
        <service
            android:name=".service.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- CameraX'in çektiği fotoğraf/videonun content:// Uri'sine çevrilmesi
             için (galeri Uri'leri zaten MediaStore'un kendi provider'ından
             geliyor, bunlar için ayrı bir şey gerekmiyordu — sadece kendi
             çektiğimiz geçici dosyalar için FileProvider şart). Bkz.
             res/xml/file_paths.xml ve StoryCreateScreen.kt. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
